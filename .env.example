# Copie para .env.local (desenvolvimento) ou cole na Vercel em
# Settings -> Environment Variables (produção).
#
# Tudo aqui é público: NEXT_PUBLIC_* aparece no HTML da página.
# Não coloque segredo nenhum neste arquivo.


# ─── 1. Domínio ────────────────────────────────────────────────────
# Só preencha quando o domínio final estiver apontado para a Vercel.
# Enquanto estiver vazio, o site fica automaticamente com noindex e usa
# a URL da própria Vercel no canonical e no Open Graph.
NEXT_PUBLIC_SITE_URL=


# ─── 2. Oferta ─────────────────────────────────────────────────────
# Preço em reais, só números, ponto como separador decimal.
# Já existe um padrão de 47.90 no código; esta variável sobrepõe.
NEXT_PUBLIC_PRICE=47.90

# Link de checkout da Kiwify: Produtos -> ... -> Ver Links
# Enquanto estiver vazio, TODOS os CTAs ficam desabilitados.
NEXT_PUBLIC_CHECKOUT_URL=


# ─── 3. Identificação do fornecedor ────────────────────────────────
# Exigida pelo Decreto 7.962/2013, que regulamenta o CDC para comércio
# eletrônico: o site que oferta ao consumidor precisa exibir nome,
# CPF ou CNPJ, endereço físico e endereço eletrônico.
# Aparece no rodapé, nos Termos de uso e na Política de privacidade.

# Seu nome completo (pessoa física) ou a razão social (pessoa jurídica).
NEXT_PUBLIC_LEGAL_ENTITY=

# CPF ou CNPJ. O rótulo é deduzido pela quantidade de dígitos —
# 11 dígitos exibem "CPF", 14 exibem "CNPJ". Não precisa mudar nada.
NEXT_PUBLIC_LEGAL_DOC=

# Endereço físico. Cidade e estado no mínimo.
NEXT_PUBLIC_LEGAL_ADDRESS=

# E-mail de atendimento. Prefira um endereço no próprio domínio a um
# Gmail — vale para confiança e para a análise das plataformas de anúncio.
NEXT_PUBLIC_CONTACT_EMAIL=


# ─── 4. Indexação ──────────────────────────────────────────────────
# Normalmente não precisa mexer: sem NEXT_PUBLIC_SITE_URL o site já
# fica com noindex sozinho. Use "1" para forçar o bloqueio mesmo com
# domínio configurado (por exemplo, num ambiente de homologação).
NEXT_PUBLIC_NOINDEX=
