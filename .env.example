# Copie para .env.local e preencha. Tudo aqui é público (NEXT_PUBLIC_*):
# são valores que aparecem na página, não segredos.

# Domínio final. Usado em canonical, Open Graph, sitemap e robots.
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Preço em reais, só números. Ex.: 47 ou 47.90
# Sem este valor a página omite o preço e o CTA fica desabilitado.
NEXT_PUBLIC_PRICE=

# Link de checkout da Kiwify: Produtos -> ... -> Ver Links
NEXT_PUBLIC_CHECKOUT_URL=

# Exigidos pelo Meta Business e pelo Google Ads nas páginas legais
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_CNPJ=
NEXT_PUBLIC_CONTACT_EMAIL=
